<Window x:Class="HorizonCyclingApp.WorkoutOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HorizonCycling Workout Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Maximized"
        Focusable="True">

    <Window.Resources>
        <!-- ガラス風コントロールボタン -->
        <Style x:Key="GlassButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2EFFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#66FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 終了ボタン（デンジャー・レッド） -->
        <Style x:Key="DangerGlassButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FCA5A5"/>
            <Setter Property="Background" Value="#33EF4444"/>
            <Setter Property="BorderBrush" Value="#66EF4444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#66EF4444"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFEF4444"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#99EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 操作透過トグルボタン（シアン・アクセント） -->
        <Style x:Key="AccentGlassButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#A5F3FC"/>
            <Setter Property="Background" Value="#3306B6D4"/>
            <Setter Property="BorderBrush" Value="#6606B6D4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#6606B6D4"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF06B6D4"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#9906B6D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="rootGrid" Background="Transparent">

        <!-- 1. 画面上部ツールバー（編集・操作用カプセルバー） -->
        <Border x:Name="toolbarBorder"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,20,0"
                Background="#D90A0E17"
                BorderBrush="#26FFFFFF"
                BorderThickness="1"
                CornerRadius="20"
                Padding="16,8"
                Opacity="0.25">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 発光グリーンドット -->
                <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,8,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#10B981"/>
                    </Border.Effect>
                </Border>
                <TextBlock Text="HORIZON WORKOUT HUD"
                           Foreground="#94A3B8"
                           FontFamily="Segoe UI, Outfit, Arial"
                           FontSize="11"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>

                <Button x:Name="btnPrevStep" Content="⏮" Style="{StaticResource GlassButtonStyle}" Margin="0,0,6,0" Click="BtnPrevStep_Click"/>
                <Button x:Name="btnPauseWorkout" Content="⏸" Style="{StaticResource GlassButtonStyle}" Margin="0,0,6,0" Click="BtnPauseWorkout_Click"/>
                <Button x:Name="btnSkipStep" Content="⏭" Style="{StaticResource GlassButtonStyle}" Margin="0,0,6,0" Click="BtnSkipStep_Click"/>
                <Button x:Name="btnStopWorkout" Content="⏹ 終了" Style="{StaticResource DangerGlassButtonStyle}" Margin="0,0,12,0" Click="BtnStopWorkout_Click"/>

                <Rectangle Width="1" Height="16" Fill="#26FFFFFF" Margin="0,0,12,0"/>

                <Button x:Name="btnToggleClickThrough"
                        Content="🛡️ 操作透過中"
                        Style="{StaticResource AccentGlassButtonStyle}"
                        Click="BtnToggleClickThrough_Click"/>
            </StackPanel>
        </Border>

        <!-- 2. 左上: ワークアウト進行リスト (250px幅のスタイリッシュカード) -->
        <Border x:Name="segmentListWidget"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="24,60,0,0"
                Width="250"
                Background="#D90A0E17"
                BorderBrush="#26FFFFFF"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.4"/>
            </Border.Effect>
            <StackPanel>
                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock x:Name="txtWorkoutTitle"
                               Text="WORKOUT"
                               Foreground="#06B6D4"
                               FontFamily="Segoe UI, Outfit, Arial"
                               FontSize="13"
                               FontWeight="ExtraBold"
                               DockPanel.Dock="Left"
                               MaxWidth="140"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="txtOverallTime"
                               Text="00:00 / 00:00"
                               Foreground="#94A3B8"
                               FontFamily="Consolas, Segoe UI Mono"
                               FontSize="11"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Right"/>
                </DockPanel>
                <Rectangle Height="1" Fill="#26FFFFFF" Margin="0,0,0,8"/>
                <StackPanel x:Name="segmentItemsStackPanel">
                    <!-- コードビハインドで生成 -->
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 3. 中央上部: メイン・インターバルアーチHUD (Zwift完全再現 580px) -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0">
            <!-- カウントダウンバナー -->
            <Border x:Name="countdownBanner"
                    CornerRadius="20"
                    Padding="24,6"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10"
                    Visibility="Collapsed">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F2EF4444" Offset="0.0"/>
                        <GradientStop Color="#F2F97316" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#EF4444" Opacity="0.8"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="NEXT INTERVAL IN  " Foreground="#FFFFFF" FontFamily="Segoe UI, Outfit" FontWeight="ExtraBold" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtCountdown" Text="3" Foreground="#FFFFFF" FontFamily="Segoe UI, Outfit" FontWeight="Black" FontSize="26" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- メインアーチカード (Zwift風 580pxカード) -->
            <Border Width="580"
                    Background="#E0121826"
                    BorderThickness="1,3,1,1"
                    CornerRadius="16"
                    Padding="20,14">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#06B6D4" Offset="0.0"/>
                        <GradientStop Color="#10B981" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Color="#000000" Opacity="0.6"/>
                </Border.Effect>
                <StackPanel>
                    <!-- 上部メタ情報 -->
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock x:Name="txtBlockTitle"
                                   Text="BLOCK 1/5: WARMUP"
                                   Foreground="#06B6D4"
                                   FontFamily="Segoe UI, Outfit, Arial"
                                   FontSize="13"
                                   FontWeight="ExtraBold"
                                   DockPanel.Dock="Left"/>
                        <TextBlock x:Name="txtBlockRemaining"
                                   Text="⏱ 05:00"
                                   Foreground="#EAB308"
                                   FontFamily="Consolas, Segoe UI Mono"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>

                    <!-- メトリクス 3列レイアウト (Power / Gauge / Cadence) -->
                    <Grid Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <!-- 列1: TARGET POWER & 実測 -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TARGET POWER" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="0,0,0,2"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock x:Name="txtTargetPower" Text="180" Foreground="#F8FAFC" FontFamily="Segoe UI, Outfit, Arial" FontSize="36" FontWeight="Black" LineHeight="36"/>
                                <TextBlock Text="W" Foreground="#94A3B8" FontFamily="Segoe UI, Outfit, Arial" FontSize="14" FontWeight="Bold" Margin="4,0,0,6" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="実測: " Foreground="#94A3B8" FontSize="11"/>
                                <TextBlock x:Name="txtActualPower" Text="182" Foreground="#F8FAFC" FontFamily="Consolas, Segoe UI Mono" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text=" W " Foreground="#94A3B8" FontSize="11"/>
                                <TextBlock x:Name="txtPowerDiff" Text="(+2W)" Foreground="#10B981" FontFamily="Consolas, Segoe UI Mono" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 列2: パワー差分インジケーターゲージ (Zwift風 DOWN/JUST/UP) -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="150">
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="DOWN" Foreground="#64748B" FontSize="8" FontWeight="Bold" DockPanel.Dock="Left"/>
                                <TextBlock Text="JUST" Foreground="#64748B" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="UP" Foreground="#64748B" FontSize="8" FontWeight="Bold" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <!-- トラック -->
                            <Border Height="8" CornerRadius="4" Background="#14FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" ClipToBounds="True">
                                <Canvas x:Name="canvasGaugeTrack" Height="8">
                                    <!-- 中央ピンポインター -->
                                    <Border x:Name="gaugePointer"
                                            Canvas.Left="69"
                                            Canvas.Top="0"
                                            Width="12"
                                            Height="8"
                                            CornerRadius="3"
                                            Background="#10B981">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#10B981"/>
                                        </Border.Effect>
                                    </Border>
                                </Canvas>
                            </Border>
                            <!-- 実車速・心拍 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <TextBlock x:Name="txtSpeed" Text="32.4 km/h" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                <TextBlock x:Name="txtHeartRate" Text="145 bpm" Foreground="#EF4444" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 列3: TARGET CADENCE & 実測 -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Width="160">
                            <TextBlock Text="TARGET CADENCE" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="0,0,0,2"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock x:Name="txtTargetCadence" Text="90" Foreground="#F8FAFC" FontFamily="Segoe UI, Outfit, Arial" FontSize="36" FontWeight="Black" LineHeight="36"/>
                                <TextBlock Text="RPM" Foreground="#94A3B8" FontFamily="Segoe UI, Outfit, Arial" FontSize="14" FontWeight="Bold" Margin="4,0,0,6" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="実測: " Foreground="#94A3B8" FontSize="11"/>
                                <TextBlock x:Name="txtActualCadence" Text="89" Foreground="#F8FAFC" FontFamily="Consolas, Segoe UI Mono" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text=" RPM" Foreground="#94A3B8" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- 下部プログレスバー (シアン〜グリーン グラデーション) -->
                    <Border Height="6" Background="#14FFFFFF" CornerRadius="3" Margin="0,6,0,0" ClipToBounds="True">
                        <Grid>
                            <Rectangle x:Name="rectProgressBarFill"
                                       HorizontalAlignment="Left"
                                       Width="0"
                                       Height="6"
                                       RadiusX="3"
                                       RadiusY="3">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#06B6D4" Offset="0.0"/>
                                        <GradientStop Color="#10B981" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- コーチメッセージポップアップ (カプセル型 シアン枠) -->
            <Border x:Name="coachMessageBorder"
                    Background="#E60F172A"
                    BorderBrush="#8006B6D4"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="20,8"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💬 " FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtCoachMessage"
                               Text="フォームを意識してペダリングを維持しよう！"
                               Foreground="#E2E8F0"
                               FontFamily="Segoe UI, Inter, Arial"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 編集モード時のヒントバナー (アンバーオレンジ カプセル) -->
            <Border x:Name="editModeBanner"
                    Background="#F2F59E0B"
                    CornerRadius="20"
                    Padding="20,6"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.5"/>
                </Border.Effect>
                <TextBlock Text="⚠️ 編集モード中（マウス操作可能）。「⏹ 終了」ボタン、または Ctrl + Shift + Q で終了できます"
                           Foreground="#000000"
                           FontFamily="Segoe UI, Inter, Arial"
                           FontSize="12"
                           FontWeight="Bold"/>
            </Border>
        </StackPanel>

        <!-- 4. 画面最下部: 全体プロファイル & ゾーンリボン (全幅 28px) -->
        <Border VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Height="28"
                Background="#D90A0E17"
                BorderBrush="#26FFFFFF"
                BorderThickness="0,1,0,0">
            <Grid>
                <!-- ゾーン色分けリボン -->
                <Canvas x:Name="canvasRibbon" Height="28"/>

                <!-- 現在自走位置ピン (白い下向き三角形 ▲ + 時間ピル) -->
                <Canvas x:Name="canvasPinLayer" Height="28">
                    <StackPanel x:Name="pinPointer"
                                Canvas.Left="0"
                                Canvas.Top="-16"
                                HorizontalAlignment="Center"
                                Width="40"
                                Margin="-20,0,0,0">
                        <!-- 三角形 -->
                        <Polygon Points="14,0 26,0 20,8" Fill="#FFFFFF" HorizontalAlignment="Center">
                            <Polygon.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#FFFFFF"/>
                            </Polygon.Effect>
                        </Polygon>
                        <!-- 時間バッジ -->
                        <Border Background="#000000" CornerRadius="3" Padding="4,1" HorizontalAlignment="Center" Margin="0,-2,0,0">
                            <TextBlock x:Name="txtPinTime" Text="00:00" Foreground="#FFFFFF" FontFamily="Consolas, Segoe UI Mono" FontSize="9" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Canvas>
            </Grid>
        </Border>

    </Grid>
</Window>
