<Window x:Class="HorizonCyclingApp.WorkoutOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HorizonCycling Workout Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Maximized"
        Focusable="True">

    <Window.Resources>
        <!-- ガラス風コントロールボタン -->
        <Style x:Key="GlassButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2EFFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#66FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 終了ボタン（デンジャー・レッド） -->
        <Style x:Key="DangerGlassButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FCA5A5"/>
            <Setter Property="Background" Value="#33EF4444"/>
            <Setter Property="BorderBrush" Value="#66EF4444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#66EF4444"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFEF4444"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#99EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 操作透過トグルボタン（シアン・アクセント） -->
        <Style x:Key="AccentGlassButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#A5F3FC"/>
            <Setter Property="Background" Value="#3306B6D4"/>
            <Setter Property="BorderBrush" Value="#6606B6D4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#6606B6D4"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF06B6D4"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#9906B6D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="rootGrid" Background="Transparent">

        <!-- 1. 画面上部ツールバー（編集・操作用カプセルバー） -->
        <Border x:Name="toolbarBorder"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,20,0"
                Background="#D90A0E17"
                BorderBrush="#26FFFFFF"
                BorderThickness="1"
                CornerRadius="20"
                Padding="16,8"
                Opacity="0.25">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 発光グリーンドット -->
                <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,8,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#10B981"/>
                    </Border.Effect>
                </Border>
                <TextBlock x:Name="txtToolbarTitle"
                           Text="HORIZON WORKOUT HUD"
                           Foreground="#94A3B8"
                           FontFamily="Segoe UI, Outfit, Arial"
                           FontSize="11"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>

                <!-- ワークアウト用コントロール -->
                <StackPanel x:Name="panelWorkoutToolbarControls" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnPrevStep" Content="⏮" Style="{StaticResource GlassButtonStyle}" Margin="0,0,6,0" Click="BtnPrevStep_Click"/>
                    <Button x:Name="btnPauseWorkout" Content="⏸" Style="{StaticResource GlassButtonStyle}" Margin="0,0,6,0" Click="BtnPauseWorkout_Click"/>
                    <Button x:Name="btnSkipStep" Content="⏭" Style="{StaticResource GlassButtonStyle}" Margin="0,0,6,0" Click="BtnSkipStep_Click"/>
                    <Button x:Name="btnStopWorkout" Content="⏹ 終了" Style="{StaticResource DangerGlassButtonStyle}" Margin="0,0,12,0" Click="BtnStopWorkout_Click"/>
                </StackPanel>

                <!-- 通常走行用コントロール -->
                <StackPanel x:Name="panelFreerideToolbarControls" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <Button x:Name="btnStopFreeride" Content="💾 終了・保存" Style="{StaticResource GlassButtonStyle}" Margin="0,0,6,0" Click="BtnStopFreeride_Click"/>
                    <Button x:Name="btnHideFreeride" Content="✕ 非表示" Style="{StaticResource DangerGlassButtonStyle}" Margin="0,0,12,0" Click="BtnHideFreeride_Click"/>
                </StackPanel>

                <Rectangle Width="1" Height="16" Fill="#26FFFFFF" Margin="0,0,12,0"/>

                <Button x:Name="btnToggleClickThrough"
                        Content="🛡️ 操作透過中"
                        Style="{StaticResource AccentGlassButtonStyle}"
                        Click="BtnToggleClickThrough_Click"/>
            </StackPanel>
        </Border>

        <!-- 2. 左上: ワークアウト進行リスト (250px幅のスタイリッシュカード) -->
        <Border x:Name="segmentListWidget"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="24,60,0,0"
                Width="250"
                Background="#D90A0E17"
                BorderBrush="#26FFFFFF"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.4"/>
            </Border.Effect>
            <StackPanel>
                <DockPanel Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock x:Name="txtWorkoutTitle"
                               Text="WORKOUT"
                               Foreground="#06B6D4"
                               FontFamily="Segoe UI, Outfit, Arial"
                               FontSize="13"
                               FontWeight="ExtraBold"
                               DockPanel.Dock="Left"
                               MaxWidth="140"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="txtOverallTime"
                               Text="00:00 / 00:00"
                               Foreground="#CBD5E1"
                               FontFamily="Consolas, Segoe UI Mono"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Right"/>
                </DockPanel>
                <Rectangle Height="1" Fill="#26FFFFFF" Margin="0,0,0,8"/>
                <StackPanel x:Name="segmentItemsStackPanel">
                    <!-- コードビハインドで生成 -->
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 3. 中央上部: メイン・インターバルアーチHUD (Zwift完全再現 580px) -->
        <StackPanel x:Name="workoutArchContainer" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0">
            <!-- ランプテスト限界警告バナー (ケイデンス低下時) -->
            <Border x:Name="rampCadenceWarningBanner"
                    CornerRadius="20"
                    Padding="24,8"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10"
                    Visibility="Collapsed">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F2DC2626" Offset="0.0"/>
                        <GradientStop Color="#F2EA580C" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="0" Color="#DC2626" Opacity="0.9"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="lblRampCadenceWarning" Text="⚠️ ケイデンス低下！ 50 RPM以上を維持してください！ " Foreground="#FFFFFF" FontFamily="Segoe UI, Outfit" FontWeight="Black" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtRampLowCadenceSec" Text="[2.1s]" Foreground="#FEF08A" FontFamily="Segoe UI, Outfit" FontWeight="Black" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ランプテスト完了・新FTP発表バナー -->
            <Border x:Name="rampResultBanner"
                    CornerRadius="20"
                    Padding="26,10"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10"
                    Visibility="Collapsed">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F2059669" Offset="0.0"/>
                        <GradientStop Color="#F20D9488" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" ShadowDepth="0" Color="#059669" Opacity="0.9"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="lblRampResultTitle" Text="🎉 ランプテスト完了！ 新測定FTP: " Foreground="#FFFFFF" FontFamily="Segoe UI, Outfit" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtRampNewFtp" Text="245 W" Foreground="#FEF08A" FontFamily="Segoe UI, Outfit" FontWeight="Black" FontSize="20" VerticalAlignment="Center" Margin="4,0,4,0"/>
                    <TextBlock x:Name="txtRampFtpDelta" Text="(+25W)" Foreground="#A7F3D0" FontFamily="Segoe UI, Outfit" FontWeight="ExtraBold" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 次セグメント予告バナー (30秒前〜切り替えまで表示) -->
            <Border x:Name="nextSegmentPreviewBanner"
                    Width="660"
                    CornerRadius="14"
                    Padding="18,10"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10"
                    Visibility="Collapsed">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F00F172A" Offset="0.0"/>
                        <GradientStop Color="#F01E293B" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush x:Name="brushNextPreviewBorder" Color="#06B6D4"/>
                </Border.BorderBrush>
                <Border.BorderThickness>
                    <Thickness Left="1" Top="2" Right="1" Bottom="1"/>
                </Border.BorderThickness>
                <Border.Effect>
                    <DropShadowEffect x:Name="shadowNextPreview" BlurRadius="24" ShadowDepth="0" Color="#06B6D4" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <!-- 上段: 予告ヘッダー & 持続時間 -->
                    <DockPanel Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="⏭ " FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtNextPreviewHeader"
                                       Text="次のセグメント予告 (あと 30秒)"
                                       Foreground="#38BDF8"
                                       FontFamily="Segoe UI, Outfit, Arial"
                                       FontSize="12"
                                       FontWeight="ExtraBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="lblNextDuration" Text="持続: " Foreground="#94A3B8" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtNextDuration"
                                       Text="05:00"
                                       Foreground="#F8FAFC"
                                       FontFamily="Consolas, Segoe UI Mono"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- 下段: ゾーン・セグメント名・目標ワット・差分・目標ケイデンス -->
                    <DockPanel VerticalAlignment="Center">
                        <!-- 左側: ゾーンバッジ & セグメント種別 -->
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Border x:Name="borderNextZoneBadge"
                                    Background="#EAB308"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="txtNextZone"
                                           Text="Z4"
                                           Foreground="#FFFFFF"
                                           FontFamily="Segoe UI, Outfit, Arial"
                                           FontSize="11"
                                           FontWeight="Black"/>
                            </Border>
                            <TextBlock x:Name="txtNextType"
                                       Text="SWEETSPOT"
                                       Foreground="#F8FAFC"
                                       FontFamily="Segoe UI, Outfit, Arial"
                                       FontSize="15"
                                       FontWeight="Black"
                                       VerticalAlignment="Center"
                                       Margin="0,0,16,0"/>
                        </StackPanel>

                        <!-- 右側: 目標ワット & 差分 & ケイデンス -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="lblNextTarget"
                                       Text="目標: "
                                       Foreground="#94A3B8"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtNextTargetWatts"
                                       Text="210 W"
                                       Foreground="#06B6D4"
                                       FontFamily="Segoe UI, Outfit, Arial"
                                       FontSize="18"
                                       FontWeight="Black"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#06B6D4" Opacity="0.6"/>
                                </TextBlock.Effect>
                            </TextBlock>

                            <!-- パワー差分バッジ (+90W / -50W) -->
                            <Border x:Name="borderNextDeltaBadge"
                                    Background="#2610B981"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="txtNextPowerDelta"
                                           Text="+90W 🔺"
                                           Foreground="#10B981"
                                           FontFamily="Consolas, Segoe UI Mono"
                                           FontSize="12"
                                           FontWeight="Bold"/>
                            </Border>

                            <!-- 目標ケイデンス -->
                            <StackPanel x:Name="panelNextCadence" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔄 " FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtNextCadence"
                                           Text="90 RPM"
                                           Foreground="#CBD5E1"
                                           FontFamily="Segoe UI, Outfit, Arial"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- カウントダウンバナー -->
            <Border x:Name="countdownBanner"
                    CornerRadius="20"
                    Padding="24,6"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10"
                    Visibility="Collapsed">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F2EF4444" Offset="0.0"/>
                        <GradientStop Color="#F2F97316" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#EF4444" Opacity="0.8"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="NEXT INTERVAL IN  " Foreground="#FFFFFF" FontFamily="Segoe UI, Outfit" FontWeight="ExtraBold" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtCountdown" Text="3" Foreground="#FFFFFF" FontFamily="Segoe UI, Outfit" FontWeight="Black" FontSize="26" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- メインアーチカード (Zwift風 660px大型カード) -->
            <Border Width="660"
                    Background="#E0121826"
                    BorderThickness="1,3,1,1"
                    CornerRadius="16"
                    Padding="22,14">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#06B6D4" Offset="0.0"/>
                        <GradientStop Color="#10B981" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Color="#000000" Opacity="0.6"/>
                </Border.Effect>
                <StackPanel>
                    <!-- 上部メタ情報 (ブロックタイトル & 残り時間) -->
                    <DockPanel Margin="0,0,0,10" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                            <TextBlock x:Name="txtBlockTitle"
                                       Text="BLOCK 1/5: WARMUP"
                                       Foreground="#06B6D4"
                                       FontFamily="Segoe UI, Outfit, Arial"
                                       FontSize="14"
                                       FontWeight="ExtraBold"
                                       VerticalAlignment="Center"/>
                            <Border x:Name="borderVirtualErgBadge"
                                    Visibility="Collapsed"
                                    Background="#2638BDF8"
                                    BorderBrush="#6638BDF8"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="6,2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="txtVirtualErgBadge"
                                           Text="VIRTUAL ERG"
                                           Foreground="#38BDF8"
                                           FontFamily="Segoe UI, Outfit, Arial"
                                           FontSize="10"
                                           FontWeight="ExtraBold"/>
                            </Border>
                        </StackPanel>
                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="#26EAB308"
                                BorderBrush="#66EAB308"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,3">
                            <TextBlock x:Name="txtBlockRemaining"
                                       Text="⏱ 05:00"
                                       Foreground="#FEF08A"
                                       FontFamily="Consolas, Segoe UI Mono"
                                       FontSize="24"
                                       FontWeight="Black"
                                       VerticalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#EAB308" Opacity="0.7"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Border>
                    </DockPanel>

                    <!-- メトリクス 3列レイアウト (Power / Gauge / Cadence) -->
                    <Grid Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="176"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <!-- 列1: POWER (目標パワー & 実測パワーを両方大型・明瞭表示) -->
                        <StackPanel Grid.Column="0">
                            <!-- 目標パワー（大幅大型化 26pt・ネオンシアン発光） -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">
                                <TextBlock Text="TARGET: " Foreground="#94A3B8" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtTargetPower" Text="180W" Foreground="#06B6D4" FontFamily="Segoe UI, Outfit, Arial" FontSize="26" FontWeight="Black" VerticalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#06B6D4" Opacity="0.6"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                            
                            <!-- 実測パワー（超大型 42pt・ゾーンカラー発光） & 差分バッジ -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,2,0,0">
                                <TextBlock x:Name="txtActualPower" Text="182" Foreground="#10B981" FontFamily="Segoe UI, Outfit, Arial" FontSize="42" FontWeight="Black" LineHeight="42"/>
                                <TextBlock Text="W" Foreground="#94A3B8" FontFamily="Segoe UI, Outfit, Arial" FontSize="15" FontWeight="Bold" Margin="4,0,6,4" VerticalAlignment="Bottom"/>
                                <Border x:Name="borderDiffBadge" Background="#2610B981" CornerRadius="4" Padding="5,2" Margin="0,0,0,6" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="txtPowerDiff" Text="+2W" Foreground="#10B981" FontFamily="Consolas, Segoe UI Mono" FontSize="12" FontWeight="Bold"/>
                                </Border>
                                <Border x:Name="borderPacingGuideBadge" Visibility="Collapsed" Background="#2638BDF8" CornerRadius="4" Padding="5,2" Margin="6,0,0,6" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="txtPacingGuide" Text="▲ レバーUP" Foreground="#38BDF8" FontFamily="Segoe UI, Outfit, Arial" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- 列2: パワー差分インジケーターゲージ (DOWN/JUST/UP) & 車速・心拍 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="170">
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="DOWN" Foreground="#64748B" FontSize="9" FontWeight="Bold" DockPanel.Dock="Left"/>
                                <TextBlock Text="JUST" Foreground="#64748B" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="UP" Foreground="#64748B" FontSize="9" FontWeight="Bold" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <!-- トラック -->
                            <Border Height="8" CornerRadius="4" Background="#14FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" ClipToBounds="True">
                                <Canvas x:Name="canvasGaugeTrack" Height="8">
                                    <!-- 中央ピンポインター -->
                                    <Border x:Name="gaugePointer"
                                            Canvas.Left="79"
                                            Canvas.Top="0"
                                            Width="12"
                                            Height="8"
                                            CornerRadius="3"
                                            Background="#10B981">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#10B981"/>
                                        </Border.Effect>
                                    </Border>
                                </Canvas>
                            </Border>
                            <!-- 実車速・心拍 (実測値をくっきり大型表示) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="txtSpeed" Text="32.4 km/h" Foreground="#F8FAFC" FontSize="13" FontWeight="Bold" Margin="0,0,10,0"/>
                                <TextBlock Text="❤️ " Foreground="#EF4444" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtHeartRate" Text="145 bpm" Foreground="#EF4444" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 列3: CADENCE (目標ケイデンス & 実測ケイデンスを両方大型・明瞭表示) -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Width="220">
                            <!-- 目標ケイデンス（大幅大型化 26pt・ネオンシアン発光） -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="TARGET: " Foreground="#94A3B8" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtTargetCadence" Text="90 RPM" Foreground="#06B6D4" FontFamily="Segoe UI, Outfit, Arial" FontSize="26" FontWeight="Black" VerticalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#06B6D4" Opacity="0.6"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                            
                            <!-- 実測ケイデンス（超大型 42pt） -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,2,0,0">
                                <TextBlock x:Name="txtActualCadence" Text="89" Foreground="#F8FAFC" FontFamily="Segoe UI, Outfit, Arial" FontSize="42" FontWeight="Black" LineHeight="42"/>
                                <TextBlock Text="RPM" Foreground="#94A3B8" FontFamily="Segoe UI, Outfit, Arial" FontSize="15" FontWeight="Bold" Margin="4,0,0,4" VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- 下部プログレスバー (シアン〜グリーン グラデーション) -->
                    <Border Height="6" Background="#14FFFFFF" CornerRadius="3" Margin="0,6,0,0" ClipToBounds="True">
                        <Grid>
                            <Rectangle x:Name="rectProgressBarFill"
                                       HorizontalAlignment="Left"
                                       Width="0"
                                       Height="6"
                                       RadiusX="3"
                                       RadiusY="3">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#06B6D4" Offset="0.0"/>
                                        <GradientStop Color="#10B981" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- コーチメッセージポップアップ (カプセル型 シアン枠) -->
            <Border x:Name="coachMessageBorder"
                    Background="#E60F172A"
                    BorderBrush="#8006B6D4"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="20,8"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💬 " FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtCoachMessage"
                               Text="フォームを意識してペダリングを維持しよう！"
                               Foreground="#E2E8F0"
                               FontFamily="Segoe UI, Inter, Arial"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 編集モード時のヒントバナー (アンバーオレンジ カプセル) -->
            <Border x:Name="editModeBanner"
                    Background="#F2F59E0B"
                    CornerRadius="20"
                    Padding="20,6"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.5"/>
                </Border.Effect>
                <TextBlock x:Name="lblEditModeHint"
                           Text="⚠️ 編集モード中（マウス操作可能）。「⏹ 終了」ボタン、または Ctrl + Shift + Q で終了できます"
                           Foreground="#000000"
                           FontFamily="Segoe UI, Inter, Arial"
                           FontSize="12"
                           FontWeight="Bold"/>
            </Border>
        </StackPanel>

        <!-- 3.5 通常走行時メインHUD (Zwift風 680px大型カード) -->
        <Border x:Name="freerideHudWidget"
                Width="680"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,24,0,0"
                Background="#E0121826"
                BorderThickness="1,3,1,1"
                CornerRadius="16"
                Padding="20,14"
                Visibility="Collapsed">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#06B6D4" Offset="0.0"/>
                    <GradientStop Color="#10B981" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Color="#000000" Opacity="0.6"/>
            </Border.Effect>
            <StackPanel>
                <!-- 上部メタ情報 (走行時間・セッション状態) -->
                <DockPanel Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,6,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#10B981"/>
                            </Border.Effect>
                        </Border>
                        <TextBlock Text="FREERIDE HUD"
                                   Foreground="#06B6D4"
                                   FontFamily="Segoe UI, Outfit, Arial"
                                   FontSize="13"
                                   FontWeight="ExtraBold"
                                   VerticalAlignment="Center"/>
                        <Border x:Name="borderFreerideStateBadge" Background="#2610B981" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="txtFreerideState" Text="REC" Foreground="#10B981" FontFamily="Segoe UI, Outfit, Arial" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    
                    <TextBlock x:Name="txtFreerideTime"
                               Text="⏱ 00:00:00"
                               Foreground="#EAB308"
                               FontFamily="Consolas, Segoe UI Mono"
                               FontSize="14"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <!-- メインメトリクス 3列レイアウト (Power & W/kg | Cadence & Heart Rate | Grade & Elevation) -->
                <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                    <!-- 列1: POWER & W/kg -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="POWER" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock x:Name="txtFreeridePower" Text="0" Foreground="#10B981" FontFamily="Segoe UI, Outfit, Arial" FontSize="44" FontWeight="Black" LineHeight="44"/>
                            <TextBlock Text="W" Foreground="#94A3B8" FontFamily="Segoe UI, Outfit, Arial" FontSize="16" FontWeight="Bold" Margin="4,0,0,6" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="txtFreerideWkg" Text="0.0 W/kg" Foreground="#38BDF8" FontFamily="Segoe UI, Outfit, Arial" FontSize="14" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- パワーゾーンバー -->
                        <Border Height="4" Background="#14FFFFFF" CornerRadius="2" Margin="0,6,0,0" ClipToBounds="True">
                            <Rectangle x:Name="rectFreeridePowerZoneBar" HorizontalAlignment="Left" Width="0" Height="4" Fill="#10B981"/>
                        </Border>
                    </StackPanel>

                    <!-- 列2: CADENCE & HEART RATE -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" Width="180">
                        <!-- ケイデンス -->
                        <TextBlock Text="CADENCE" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock x:Name="txtFreerideCadence" Text="--" Foreground="#F8FAFC" FontFamily="Segoe UI, Outfit, Arial" FontSize="36" FontWeight="Black" LineHeight="36"/>
                            <TextBlock Text="RPM" Foreground="#94A3B8" FontFamily="Segoe UI, Outfit, Arial" FontSize="14" FontWeight="Bold" Margin="4,0,0,4" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        
                        <!-- 心拍数 -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                            <TextBlock Text="❤️ " Foreground="#EF4444" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtFreerideHeartRate" Text="-- bpm" Foreground="#EF4444" FontSize="15" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                            <Border x:Name="borderFreerideHrZone" Background="#26EF4444" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="txtFreerideHrZone" Text="Z0" Foreground="#FCA5A5" FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- 列3: GRADE & ELEVATION -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" Width="200">
                        <TextBlock Text="GRADE &amp; ELEVATION" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="0,0,0,2" HorizontalAlignment="Right"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                            <TextBlock x:Name="txtFreerideGrade" Text="+0.0" Foreground="#F59E0B" FontFamily="Segoe UI, Outfit, Arial" FontSize="36" FontWeight="Black" LineHeight="36"/>
                            <TextBlock Text="%" Foreground="#94A3B8" FontFamily="Segoe UI, Outfit, Arial" FontSize="16" FontWeight="Bold" Margin="2,0,0,4" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock x:Name="lblFreerideElevation" Text="標高: " Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="txtFreerideElevation" Text="0 m" Foreground="#CBD5E1" FontSize="12" FontWeight="Bold" Margin="0,0,8,0"/>
                            <TextBlock x:Name="lblFreerideGain" Text="獲得: " Foreground="#64748B" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="txtFreerideGain" Text="+0 m" Foreground="#10B981" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 下部境界線 -->
                <Rectangle Height="1" Fill="#1AFFFFFF" Margin="0,4,0,8"/>

                <!-- 下部補助メトリクス: 距離・カロリー & スロットル・ブレーキ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 距離 & カロリー -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="DIST: " Foreground="#64748B" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtFreerideDistance" Text="0.00 km" Foreground="#F8FAFC" FontFamily="Segoe UI, Outfit, Arial" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        
                        <TextBlock Text="CAL: " Foreground="#64748B" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtFreerideCalories" Text="0 kcal" Foreground="#F8FAFC" FontFamily="Segoe UI, Outfit, Arial" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- スロットル & ブレーキ開度バー -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- スロットル -->
                        <TextBlock Text="THR" Foreground="#64748B" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Border Width="70" Height="8" Background="#14FFFFFF" CornerRadius="4" ClipToBounds="True" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Rectangle x:Name="rectFreerideThrottleBar" HorizontalAlignment="Left" Width="0" Height="8" Fill="#10B981"/>
                        </Border>
                        <TextBlock x:Name="txtFreerideThrottle" Text="0%" Foreground="#94A3B8" FontFamily="Consolas, monospace" FontSize="10" FontWeight="Bold" Width="30" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <!-- ブレーキ -->
                        <TextBlock Text="BRK" Foreground="#64748B" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Border Width="70" Height="8" Background="#14FFFFFF" CornerRadius="4" ClipToBounds="True" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Rectangle x:Name="rectFreerideBrakeBar" HorizontalAlignment="Left" Width="0" Height="8" Fill="#EF4444"/>
                        </Border>
                        <TextBlock x:Name="txtFreerideBrake" Text="0%" Foreground="#94A3B8" FontFamily="Consolas, monospace" FontSize="10" FontWeight="Bold" Width="30" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 4. 画面最下部: 全体プロファイル & ゾーンリボン (全幅 28px) -->
        <Border x:Name="workoutRibbonWidget"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Height="28"
                Background="#D90A0E17"
                BorderBrush="#26FFFFFF"
                BorderThickness="0,1,0,0">
            <Grid>
                <!-- ゾーン色分けリボン -->
                <Canvas x:Name="canvasRibbon" Height="28"/>

                <!-- 現在自走位置ピン (白い下向き三角形 ▲ + 時間ピル) -->
                <Canvas x:Name="canvasPinLayer" Height="28">
                    <StackPanel x:Name="pinPointer"
                                Canvas.Left="0"
                                Canvas.Top="-16"
                                HorizontalAlignment="Center"
                                Width="40"
                                Margin="-20,0,0,0">
                        <!-- 三角形 -->
                        <Polygon Points="14,0 26,0 20,8" Fill="#FFFFFF" HorizontalAlignment="Center">
                            <Polygon.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#FFFFFF"/>
                            </Polygon.Effect>
                        </Polygon>
                        <!-- 時間バッジ -->
                        <Border Background="#000000" CornerRadius="3" Padding="4,1" HorizontalAlignment="Center" Margin="0,-2,0,0">
                            <TextBlock x:Name="txtPinTime" Text="00:00" Foreground="#FFFFFF" FontFamily="Consolas, Segoe UI Mono" FontSize="9" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Canvas>
            </Grid>
        </Border>

    </Grid>
</Window>
